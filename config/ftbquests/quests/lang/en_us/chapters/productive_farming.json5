  "quest.01B7B66FAAAAEAE5.quest_subtitle": "White",
  "quest.2F1B74D45E50A079.title": "&9Great Lobelia",
  "quest.3111C0CA63A82E7A.quest_desc": [
    "Blue Jade Corn is made with Yellow Dent Corn and Cornflowers. \n\nSo that is why they're called Cornflowers!",
  ],
  "quest.0D04BCF5940E2AF1.quest_desc": [
    "Combining Blue Jade Corn and Black Aztec Corn gives us Sugar Pearl Corn.",
  ],
  "quest.523AD3D448DE58A6.quest_desc": [
    "{image:atm:textures/questpics/pro_farming/farm_hellebore.png width:100 height:150 align:center}",
  ],
  "quest.06B197EB778C17AC.title": "&6Mutations",
  "quest.46932B57EF21D346.quest_desc": [
    "The &9Watering Trough&r is another Block that will help with Animals. \n\nInstead of taking &cAnimal Food&r though, it will take &9Water Buckets&r! \n\nWhen Baby Animals are near the &9Watering Trough&r, they will Grow faster than Babies who aren't. \n\nDon't forget to keep Filling it with &9Water&r though!",
  ],
  "quest.6C31A50068FBA0EE.quest_desc": [
    "{image:atm:textures/questpics/pro_farming/farm_bearded.png width:100 height:150 align:center}",
  ],
