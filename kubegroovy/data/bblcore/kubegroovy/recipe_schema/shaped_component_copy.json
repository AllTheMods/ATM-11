      "role": "input"
    },
    {
      "name": "copy_components",
      "type": {
        "type": "list",
        "component": "id",
        "min": 0
      }
    },
    {
      "name": "group",
      "type": "optional_string",
      "optional": ""
    },
    {
      "name": "category",
